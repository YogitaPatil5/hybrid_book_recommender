# Copy to `.env` and adjust. Every variable is prefixed with BOOKMIND_.
# Values here are the defaults; anything you omit falls back to them.

# ── Runtime ──────────────────────────────────────────────────────────────────
BOOKMIND_ENV=development            # development | staging | production
BOOKMIND_DEBUG=false                # never true in production (enforced)
BOOKMIND_ENABLE_DOCS=false          # true = keep /docs visible in production (public demo)
BOOKMIND_HOST=0.0.0.0
BOOKMIND_PORT=8000
BOOKMIND_WORKERS=2

# ── Paths ────────────────────────────────────────────────────────────────────
BOOKMIND_DATA_DIR=data
BOOKMIND_ARTIFACTS_DIR=artifacts
BOOKMIND_LOG_DIR=logs

# ── Logging ──────────────────────────────────────────────────────────────────
BOOKMIND_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
BOOKMIND_LOG_JSON=false             # true => one JSON object per line (prod)
BOOKMIND_LOG_TO_FILE=true

# ── ML ───────────────────────────────────────────────────────────────────────
BOOKMIND_EMBEDDING_BACKEND=sentence-transformers   # sentence-transformers | hashing
BOOKMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2
BOOKMIND_EMBEDDING_CACHE_SIZE=2048
BOOKMIND_ENABLE_KNN=true

# ── API limits & security ────────────────────────────────────────────────────
BOOKMIND_MAX_QUERY_LENGTH=300
BOOKMIND_MAX_TOP_K=50
BOOKMIND_DEFAULT_TOP_K=12
BOOKMIND_RATE_LIMIT=60/minute
BOOKMIND_RATE_LIMIT_ENABLED=true
BOOKMIND_CORS_ORIGINS=["http://localhost:8000"]
BOOKMIND_TRUSTED_HOSTS=["*"]
BOOKMIND_FRAME_ANCESTORS=[]         # sites allowed to embed the pages, e.g. ["https://huggingface.co"]
BOOKMIND_MOUNTED_APP_PATHS=[]       # sub-apps with their own scripts, e.g. ["/demo"] (no CSP, no rate limit)

# ── Pipeline (genre classification) ──────────────────────────────────────────
BOOKMIND_OLLAMA_MODEL=llama3.2
BOOKMIND_OLLAMA_HOST=http://localhost:11434
